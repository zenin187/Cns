#include <stdio.h>
#include <stdlib.h>
#include <string.h>

void main() {
    char str[] = "Helloworld";
    char str1[11];
    char str2[11], str3[11];
    int i, len;
    
    len = strlen(str);
    strcpy(str2, str);
    
    for(i = 0; i < len; i++) {
        str[i] = str[i] & 127;
        printf("%c", str[i]);
    }
    printf("\n");
    
    for(i = 0; i < len; i++) {
        str3[i] = str2[i] ^ 127;
        printf("%c", str3[i]);
    }
    printf("\n");
}


